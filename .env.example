# Copy this file to .env and fill in real values. .env is gitignored —
# never commit real secrets. Variables marked REQUIRED have no default in
# docker-compose.yml, so the stack will refuse to start until they are set.

# --- Database: single PostgreSQL, database `bib`, three schemas (auth/budget/investment) ---
BIB_POSTGRES_DB=bib
BIB_POSTGRES_USER=bib
BIB_POSTGRES_PASSWORD=change-me                 # REQUIRED

# --- Application (the monolith) ---
APP_PORT=8082
CORS_ALLOWED_ORIGINS=http://localhost:8080
JWT_COOKIE_SECURE=false                          # true when served over HTTPS
MOEX_ISS_BASE_URL=https://iss.moex.com/iss

# --- Server secrets (REQUIRED — two independent keys, inject real values) ---
JWT_SECRET=change-me                             # REQUIRED — HS256 access-JWT signing key
AUTH_REFRESH_TOKEN_PEPPER=change-me              # REQUIRED — HMAC pepper for stored refresh-token hashes

# --- Frontend (Vite dev server) ---
FRONTEND_PORT=8080
VITE_API_BASE_URL=http://localhost:8082

# --- Backup service (Yandex Disk via rclone OAuth) ---
YADISK_OAUTH_TOKEN=                              # generate with: rclone authorize "yandex"
YADISK_BACKUP_DIR=backups/budget-invest-bloom
